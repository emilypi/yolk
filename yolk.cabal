cabal-version: 3.0
name: yolk
version: 0.1.0.0
synopsis: Many-sorted equality saturation over higher-kinded languages
description: Typed e-graphs with mutable and persistent storage, rewriting,
             and extraction. This is an initial implementation of the core.
license: BSD-3-Clause
license-file: LICENSE
author: Emily Pillmore
maintainer: emilypi@cohomolo.gy
copyright: (c) 2026 Emily Pillmore
category: Data, Compilers
build-type: Simple
tested-with: GHC == 9.14.1
extra-source-files:
  README.md
  fourmolu.yaml
  docs/design.md
  bench/README.md
  bench/baseline.csv
  bench/baseline.md
  test/check-types.sh
  test/check-width.sh
  test/check-bench-gate.sh
  test/compile-fail/*.hs

common settings
  default-language: GHC2024
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-uni-patterns
  build-depends: base >= 4.22 && < 4.23

library
  import: settings
  hs-source-dirs: src
  exposed-modules:
    Yolk
    Yolk.Language
    Yolk.EGraph
    Yolk.Rewrite
    Yolk.Extract
    Yolk.Extract.Dag
    Yolk.Extract.Pareto
    Yolk.Extract.Pareto.Error
    Yolk.Dag
    Yolk.Optics
    Yolk.Backend
    Yolk.Internal.Pareto
    Yolk.Internal.Types
    Yolk.Internal.Graph
    Yolk.Internal.Dag
  build-depends:
    containers >= 0.7 && < 0.9,
    hkd == 0.2.1,
    lens >= 5.3 && < 5.4,
    primitive >= 0.9 && < 0.10,
    transformers >= 0.6 && < 0.7,
    validation >= 1.3.3 && < 1.4,
    vector >= 0.13 && < 0.14

test-suite yolk-tests
  import: settings
  type: exitcode-stdio-1.0
  hs-source-dirs: test bench-support bench-report
  main-is: Main.hs
  other-modules:
    TestLanguage TestSupport ExtractionTests DagExtractionTests
    ParetoExtractionTests OpticsTests
    BenchVectors BenchmarkTests BenchReport BenchmarkReportTests
  build-depends:
    yolk,
    hkd,
    lens,
    containers,
    deepseq >= 1.5 && < 1.6,
    statistics >= 0.16.5 && < 0.17,
    vector >= 0.13 && < 0.14,
    validation,
    tasty >= 1.5 && < 1.6,
    tasty-hunit >= 0.10 && < 0.11,
    tasty-quickcheck >= 0.11 && < 0.12

executable yolk-example
  import: settings
  hs-source-dirs: examples
  main-is: Main.hs
  other-modules: ExampleResults
  build-depends: yolk, hkd, lens

benchmark yolk-bench
  import: settings
  type: exitcode-stdio-1.0
  hs-source-dirs: bench bench-support
  main-is: Main.hs
  other-modules: BenchVectors
  ghc-options: -rtsopts "-with-rtsopts=-T -A32m" -fproc-alignment=64
  build-depends:
    yolk,
    hkd,
    deepseq >= 1.5 && < 1.6,
    tasty-bench >= 0.5.1 && < 0.6

executable yolk-bench-report
  import: settings
  hs-source-dirs: bench-report
  main-is: Main.hs
  other-modules: BenchReport
  build-depends:
    containers >= 0.7 && < 0.9,
    statistics >= 0.16.5 && < 0.17,
    vector >= 0.13 && < 0.14
